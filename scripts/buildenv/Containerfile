# The development environment as a container image: Ubuntu 26.04, as CI
# runs, with everything setup.sh installs.
#
#   docker build -t configforge-dev -f scripts/buildenv/Containerfile scripts/buildenv
#   docker run --rm -v "$PWD:/src" -w /src configforge-dev \
#     cmake -DSOURCE=tree -DWORK=/tmp/cfv -P scripts/verify.cmake
#
# podman takes the same file and the same arguments.
FROM ubuntu:26.04
# setup.sh reads the hashed lists beside it (requirements-lock.py makes them).
COPY setup.sh tools-requirements.txt semgrep-requirements.txt /tmp/cf/
RUN sh /tmp/cf/setup.sh && rm -rf /tmp/cf
WORKDIR /src
