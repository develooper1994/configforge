# Write the commit a build comes from into a header, for cf_build_id().
#
#   cmake -DSRC=<dir> -DOUT=<header> [-DGIT=<git>] -P scripts/buildid.cmake
#
# The build runs this on every build (ConfigForgeVersion.cmake). The id
# is git's abbreviated hash, with "-dirty" when tracked files differ from
# the commit; from a git archive, which has no .git, it is the hash git
# wrote into cmake/build-id.txt (export-subst in .gitattributes); and
# otherwise it is empty, because a guess would be worse than nothing.
# The header is written only when the id changed, so an unchanged id
# rebuilds nothing.

cmake_minimum_required(VERSION 3.10)
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/ConfigForgeVersion.cmake")

if(NOT DEFINED SRC OR NOT DEFINED OUT)
  message(FATAL_ERROR "buildid: SRC and OUT are required")
endif()

set(id "")

# A checkout - and this tree's own, not one it was copied into: a
# configforge directory vendored inside another project's repository
# would otherwise report that project's commit.
if(GIT)
  execute_process(
    COMMAND "${GIT}" -C "${SRC}" rev-parse --show-toplevel
    RESULT_VARIABLE rc
    OUTPUT_VARIABLE top
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(rc EQUAL 0)
    get_filename_component(top "${top}" REALPATH)
    get_filename_component(src_real "${SRC}" REALPATH)
    if(top STREQUAL src_real)
      execute_process(
        COMMAND "${GIT}" -C "${SRC}" rev-parse --short=7 HEAD
        RESULT_VARIABLE rc
        OUTPUT_VARIABLE hash
        OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(rc EQUAL 0)
        set(id "${hash}")
        # --no-optional-locks: a status run by the build must not take
        # the index lock from a git command the developer is running.
        execute_process(
          COMMAND "${GIT}" --no-optional-locks -C "${SRC}" status --porcelain
                  --untracked-files=no
          OUTPUT_VARIABLE changes
          ERROR_QUIET)
        if(NOT changes STREQUAL "")
          set(id "${id}-dirty")
        endif()
      endif()
    endif()
  endif()
endif()

# A git archive: the placeholder became the hash. Anything else that
# still says $Format is a plain copy, and has no id.
if(id STREQUAL "" AND EXISTS "${SRC}/cmake/build-id.txt")
  file(STRINGS "${SRC}/cmake/build-id.txt" archived LIMIT_COUNT 1)
  if(archived MATCHES "^[0-9a-f]+$")
    set(id "${archived}")
  endif()
endif()

set(text
    "/* Generated by scripts/buildid.cmake. */\n#define CF_BUILD_ID \"${id}\"\n"
)
set(old "")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  configforge_write_lf("${OUT}" "${text}")
endif()
