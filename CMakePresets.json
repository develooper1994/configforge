{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "C89 conformance build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "CF_PROFILE": "default" }
    },
    {
      "name": "sanitize",
      "displayName": "Address and undefined behaviour sanitizers",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_PROFILE": "default",
        "CF_SANITIZE": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread sanitizer: the threading contract under a race detector",
      "binaryDir": "${sourceDir}/build-tsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_PROFILE": "default",
        "CF_SANITIZE_THREAD": "ON"
      }
    },
    {
      "name": "msan",
      "displayName": "Memory sanitizer, with no library that is not built with it: expat, sqlite and libstdc++ are off, YAML is the built-in parser (clang)",
      "binaryDir": "${sourceDir}/build-msan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CF_SANITIZE_MEMORY": "ON",
        "CF_WITH_XML": "OFF",
        "CF_WITH_SQLITE": "OFF",
        "CF_WITH_CXX": "OFF"
      }
    },
    {
      "name": "ubsan-strict",
      "displayName": "Address and undefined behaviour sanitizers with clang's integer, implicit-conversion, nullability and local-bounds groups",
      "binaryDir": "${sourceDir}/build-ubsan-strict",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CF_SANITIZE": "ON",
        "CF_SANITIZE_STRICT": "ON"
      }
    },
    {
      "name": "afl",
      "displayName": "The libFuzzer harnesses under AFL++'s driver (afl-clang-fast), run by scripts/check/afl.cmake",
      "binaryDir": "${sourceDir}/build-afl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "afl-clang-fast",
        "CMAKE_CXX_COMPILER": "afl-clang-fast++",
        "CF_FUZZ": "ON",
        "CF_WITH_CXX": "OFF"
      }
    },
    {
      "name": "coverage",
      "displayName": "Line coverage of the library by the suite (gcov, gcovr)",
      "binaryDir": "${sourceDir}/build-coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_PROFILE": "default",
        "CF_COVERAGE": "ON"
      }
    },
    {
      "name": "mcdc",
      "displayName": "MC/DC of the library by the suite (GCC condition coverage)",
      "binaryDir": "${sourceDir}/build-mcdc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_PROFILE": "default",
        "CF_COVERAGE": "ON",
        "CF_COVERAGE_MCDC": "ON"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer harnesses with ASan and UBSan (clang)",
      "binaryDir": "${sourceDir}/build-fuzz",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CF_PROFILE": "default",
        "CF_FUZZ": "ON"
      }
    },
    {
      "name": "analyze",
      "displayName": "GCC -fanalyzer and cppcheck",
      "binaryDir": "${sourceDir}/build-analyze",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_PROFILE": "default",
        "CF_ANALYZER": "ON",
        "CF_CPPCHECK": "ON"
      }
    },
    {
      "name": "portable",
      "displayName": "Every opportunistic upgrade disabled, optimised (-O2)",
      "binaryDir": "${sourceDir}/build-portable",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CF_PROFILE": "default",
        "CF_FORCE_PORTABLE": "ON",
        "CF_SINGLE_THREADED": "ON"
      }
    },
    {
      "name": "minimal",
      "displayName": "Every optional part but the codecs off, short limits, a 1 KB stack budget, -Os, unused sections dropped",
      "binaryDir": "${sourceDir}/build-minimal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CF_PROFILE": "minimal"
      }
    },
    {
      "name": "full",
      "displayName": "Every part that builds on a host with expat and sqlite3.",
      "binaryDir": "${sourceDir}/build-full",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CF_PROFILE": "full"
      }
    },
    {
      "name": "server",
      "displayName": "Every format, XML too, and every source but SQLite and preferences.",
      "binaryDir": "${sourceDir}/build-server",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CF_PROFILE": "server"
      }
    },
    {
      "name": "misra",
      "displayName": "The build a MISRA C checker runs against: minimal, one thread, no reals.",
      "binaryDir": "${sourceDir}/build-misra",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_PROFILE": "misra"
      }
    },
    {
      "name": "none",
      "displayName": "No operating system: CF_PLATFORM=none, with the host's C library standing for newlib; the whole suite, a test that needs what none cannot give skips by asking the platform.",
      "binaryDir": "${sourceDir}/build-none",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_PROFILE": "default",
        "CF_PLATFORM": "none",
        "CF_BUILD_TOOLS": "OFF",
        "CF_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "none-bare",
      "displayName": "No operating system and no C library: CF_PLATFORM=none, CF_NO_STDIO and CF_NO_STDLIB; its one test is the freestanding program.",
      "binaryDir": "${sourceDir}/build-none-bare",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CF_PROFILE": "minimal",
        "CF_PLATFORM": "none",
        "CF_NO_STDIO": "ON",
        "CF_NO_STDLIB": "ON",
        "CF_BUILD_TOOLS": "OFF",
        "CF_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "embedded-json",
      "displayName": "JSON alone, for a device: no files, no reals, one thread, nesting 16.",
      "binaryDir": "${sourceDir}/build-embedded-json",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CF_PROFILE": "embedded-json",
        "CF_BUILD_TOOLS": "OFF",
        "CF_BUILD_EXAMPLES": "OFF"
      }
    },
    {
      "name": "embedded-cbor",
      "displayName": "CBOR alone, for a device: no files, no reals, one thread, nesting 16.",
      "binaryDir": "${sourceDir}/build-embedded-cbor",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CF_PROFILE": "embedded-cbor",
        "CF_BUILD_TOOLS": "OFF",
        "CF_BUILD_EXAMPLES": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "default",  "configurePreset": "default",  "configuration": "Debug" },
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug" },
    { "name": "tsan",     "configurePreset": "tsan",     "configuration": "Debug" },
    { "name": "msan",     "configurePreset": "msan",     "configuration": "Debug" },
    { "name": "ubsan-strict", "configurePreset": "ubsan-strict", "configuration": "Debug" },
    { "name": "afl",      "configurePreset": "afl",      "configuration": "RelWithDebInfo" },
    { "name": "coverage", "configurePreset": "coverage", "configuration": "Debug" },
    { "name": "mcdc",     "configurePreset": "mcdc",     "configuration": "Debug" },
    { "name": "fuzz",     "configurePreset": "fuzz",     "configuration": "RelWithDebInfo" },
    { "name": "analyze",  "configurePreset": "analyze",  "configuration": "Debug" },
    { "name": "portable", "configurePreset": "portable", "configuration": "Release" },
    { "name": "minimal",  "configurePreset": "minimal",  "configuration": "MinSizeRel" },
    { "name": "full", "configurePreset": "full", "configuration": "Release" },
    { "name": "server", "configurePreset": "server", "configuration": "Release" },
    { "name": "misra", "configurePreset": "misra", "configuration": "Debug" },
    { "name": "none", "configurePreset": "none", "configuration": "Debug" },
    { "name": "none-bare", "configurePreset": "none-bare", "configuration": "MinSizeRel" },
    { "name": "embedded-json", "configurePreset": "embedded-json", "configuration": "MinSizeRel" },
    { "name": "embedded-cbor", "configurePreset": "embedded-cbor", "configuration": "MinSizeRel" }
  ],
  "testPresets": [
    { "name": "default",  "configurePreset": "default",  "configuration": "Debug", "output": { "outputOnFailure": true } },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
        "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1:detect_invalid_pointer_pairs=2:check_initialization_order=1"
      }
    },
    {
      "name": "ubsan-strict",
      "configurePreset": "ubsan-strict",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "environment": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1",
        "ASAN_OPTIONS": "detect_stack_use_after_return=1:strict_string_checks=1:detect_invalid_pointer_pairs=2:check_initialization_order=1"
      }
    },
    {
      "name": "msan",
      "configurePreset": "msan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "no-msan" } },
      "environment": { "MSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1", "CF_UNDER_MSAN": "1" }
    },
    { "name": "tsan",     "configurePreset": "tsan",     "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "coverage", "configurePreset": "coverage", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "mcdc",     "configurePreset": "mcdc",     "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "fuzz",     "configurePreset": "fuzz",     "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true }, "filter": { "include": { "label": "fuzz" } } },
    { "name": "analyze",  "configurePreset": "analyze",  "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "portable", "configurePreset": "portable", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "minimal",  "configurePreset": "minimal",  "configuration": "MinSizeRel", "output": { "outputOnFailure": true } },
    {"name": "full", "configurePreset": "full", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "server", "configurePreset": "server", "configuration": "Release", "output": {"outputOnFailure": true}},
    {"name": "misra", "configurePreset": "misra", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "none", "configurePreset": "none", "configuration": "Debug", "output": {"outputOnFailure": true}},
    {"name": "none-bare", "configurePreset": "none-bare", "configuration": "MinSizeRel", "output": {"outputOnFailure": true}, "filter": {"include": {"name": "^platform\\.freestanding$"}}},
    {"name": "embedded-json", "configurePreset": "embedded-json", "configuration": "MinSizeRel", "output": {"outputOnFailure": true}, "filter": {"include": {"name": "^(profile|gate\\.(version|text|layering|detection|cversion|profiles))"}}},
    {"name": "embedded-cbor", "configurePreset": "embedded-cbor", "configuration": "MinSizeRel", "output": {"outputOnFailure": true}, "filter": {"include": {"name": "^(profile|gate\\.(version|text|layering|detection|cversion|profiles))"}}}
  ]
}
