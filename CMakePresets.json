{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "C89 conformance build",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "sanitize",
      "displayName": "Address and undefined behaviour sanitizers",
      "binaryDir": "${sourceDir}/build-sanitize",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_SANITIZE": "ON"
      }
    },
    {
      "name": "analyze",
      "displayName": "GCC -fanalyzer and cppcheck",
      "binaryDir": "${sourceDir}/build-analyze",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CF_ANALYZER": "ON",
        "CF_CPPCHECK": "ON"
      }
    },
    {
      "name": "portable",
      "displayName": "Every opportunistic upgrade disabled, optimised (-O2)",
      "binaryDir": "${sourceDir}/build-portable",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CF_FORCE_PORTABLE": "ON",
        "CF_SINGLE_THREADED": "ON"
      }
    },
    {
      "name": "minimal",
      "displayName": "No floating point, short limits, size-optimised (-Os), for very small targets",
      "binaryDir": "${sourceDir}/build-minimal",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "CF_WITH_REAL": "OFF",
        "CF_KEY_MAX": "64",
        "CF_MESSAGE_MAX": "128",
        "CF_PATH_MAX": "256"
      }
    }
  ],
  "buildPresets": [
    { "name": "default",  "configurePreset": "default",  "configuration": "Debug" },
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug" },
    { "name": "analyze",  "configurePreset": "analyze",  "configuration": "Debug" },
    { "name": "portable", "configurePreset": "portable", "configuration": "Release" },
    { "name": "minimal",  "configurePreset": "minimal",  "configuration": "MinSizeRel" }
  ],
  "testPresets": [
    { "name": "default",  "configurePreset": "default",  "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "sanitize", "configurePreset": "sanitize", "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "analyze",  "configurePreset": "analyze",  "configuration": "Debug", "output": { "outputOnFailure": true } },
    { "name": "portable", "configurePreset": "portable", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "minimal",  "configurePreset": "minimal",  "configuration": "MinSizeRel", "output": { "outputOnFailure": true } }
  ]
}
