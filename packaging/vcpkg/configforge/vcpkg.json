{
  "name": "configforge",
  "version": "1.4.0",
  "description": "Configuration for C whose every value can say why it is what it is",
  "maintainers": "Mustafa Selçuk Çağlar",
  "homepage": "https://github.com/develooper1994/configforge",
  "license": "Zlib",
  "dependencies": [
    { "name": "vcpkg-cmake", "host": true },
    { "name": "vcpkg-cmake-config", "host": true }
  ],
  "default-features": ["yaml"],
  "features": {
    "yaml": {
      "description": "The YAML codec, through the built-in parser (CF_WITH_YAML)"
    },
    "xml": {
      "description": "The XML reader, through expat (CF_WITH_XML)",
      "dependencies": ["expat"]
    },
    "sqlite": {
      "description": "The SQLite store, through sqlite3 (CF_WITH_SQLITE)",
      "dependencies": ["sqlite3"]
    }
  }
}
