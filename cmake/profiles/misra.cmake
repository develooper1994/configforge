# cmake-format: off
# The build a MISRA C checker runs against: minimal, one thread, no reals.
set(CF_WITH_INI ON CACHE BOOL "profile")
set(CF_WITH_JSON ON CACHE BOOL "profile")
set(CF_WITH_TOML ON CACHE BOOL "profile")
set(CF_WITH_PROPERTIES ON CACHE BOOL "profile")
set(CF_WITH_CBOR ON CACHE BOOL "profile")
set(CF_WITH_TLV ON CACHE BOOL "profile")
set(CF_WITH_COMPOSE OFF CACHE BOOL "profile")
set(CF_WITH_XML OFF CACHE BOOL "profile")
set(CF_WITH_YAML ON CACHE BOOL "profile")
set(CF_WITH_SQLITE OFF CACHE BOOL "profile")
set(CF_WITH_PREFERENCES OFF CACHE BOOL "profile")
set(CF_WITH_DIR OFF CACHE BOOL "profile")
set(CF_WITH_DOTENV OFF CACHE BOOL "profile")
set(CF_WITH_EMIT OFF CACHE BOOL "profile")
set(CF_WITH_IMAGE OFF CACHE BOOL "profile")
set(CF_WITH_REPORT OFF CACHE BOOL "profile")
set(CF_WITH_REAL OFF CACHE BOOL "profile")
set(CF_WITH_CXX OFF CACHE BOOL "profile")
set(CF_YAML_BACKEND builtin CACHE STRING "profile")
set(CF_PLATFORM auto CACHE STRING "profile")
