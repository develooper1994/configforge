/*
 * cf_build_options.h - which features this build has.
 *
 * GENERATED. Do not edit, and do not override these: the public headers
 * change shape with them, so a consumer who disagrees with the library
 * about CF_WITH_REAL has a different sizeof for cf_value and a quiet
 * kind of corruption. They are defined unconditionally here for exactly
 * that reason - this file describes a library that is already compiled.
 *
 * The source tree's copy of this file holds defaults behind #ifndef
 * guards instead, for someone compiling the sources themselves.
 */

#ifndef CONFIGFORGE_CF_BUILD_OPTIONS_H
#define CONFIGFORGE_CF_BUILD_OPTIONS_H

#define CF_SHARED      @CF_OPT_SHARED@
#define CF_WITH_REAL   @CF_OPT_REAL@
#define CF_WITH_INI    @CF_OPT_INI@
#define CF_WITH_JSON   @CF_OPT_JSON@
#define CF_WITH_TOML   @CF_OPT_TOML@
#define CF_WITH_PROPERTIES @CF_OPT_PROPERTIES@
#define CF_WITH_XML    @CF_OPT_XML@
#define CF_WITH_YAML   @CF_OPT_YAML@
#define CF_WITH_SQLITE @CF_OPT_SQLITE@
#define CF_WITH_DIR    @CF_OPT_DIR@
#define CF_WITH_DOTENV @CF_OPT_DOTENV@
#define CF_WITH_EMIT   @CF_OPT_EMIT@
#define CF_WITH_IMAGE  @CF_OPT_IMAGE@
#define CF_WITH_REPORT @CF_OPT_REPORT@

/* The limits this build was compiled with; see the source tree's copy
   of this file for what each one costs. */
#define CF_KEY_MAX     @CF_KEY_MAX@
#define CF_MESSAGE_MAX @CF_MESSAGE_MAX@
#define CF_PATH_MAX    @CF_PATH_MAX@
#define CF_MAX_DEPTH   @CF_MAX_DEPTH@

/* Whether this build has threads: a library built single-threaded, or
   with every upgrade off, is that for every program including it, which
   gets it from here rather than from remembering a -D. */
@CF_OPT_THREADING@

#endif /* CONFIGFORGE_CF_BUILD_OPTIONS_H */
