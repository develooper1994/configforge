# Compare the generated blocks, then check the references in the whole page.
cmake_minimum_required(VERSION 3.10)

set(page "${SRC}/docs/Limits.md")
set(fresh "${BIN}/Limits.fresh.md")
configure_file("${page}" "${fresh}" COPYONLY)
execute_process(
  COMMAND "${CMAKE_COMMAND}" "-DWRITE=${fresh}" -P
          "${SRC}/scripts/generate/limits.cmake" RESULT_VARIABLE rc)
set(mismatch
    "docs/Limits.md does not match the sources: run cmake -DWRITE=docs/Limits.md -P scripts/generate/limits.cmake"
)
if(NOT rc EQUAL 0)
  message(
    FATAL_ERROR "scripts/generate/limits.cmake: cannot be run\n${mismatch}")
endif()
file(READ "${page}" have)
file(READ "${fresh}" want)
string(REPLACE "\r" "" have "${have}")
string(REPLACE "\r" "" want "${want}")
if(NOT have STREQUAL want)
  message(FATAL_ERROR "${mismatch}")
endif()

file(READ "${SRC}/docs/Decisions.md" decisions)
string(REGEX MATCHALL "D-[0-9]+" references "${have}")
list(REMOVE_DUPLICATES references)
foreach(ref IN LISTS references)
  if(NOT decisions MATCHES "(^|\n)## ${ref}([ \t\n]|$)")
    message(
      FATAL_ERROR
        "docs/Limits.md names ${ref}, which docs/Decisions.md does not have")
  endif()
endforeach()

# Inspect the declarations even for tests omitted by a particular profile.
file(GLOB component_lists "${SRC}/lib/*/tests/CMakeLists.txt")
file(GLOB_RECURSE test_lists "${SRC}/tests/CMakeLists.txt")
set(registered "")
foreach(input IN LISTS component_lists test_lists)
  file(READ "${input}" declarations)
  string(REGEX REPLACE "#[^\n]*" "" declarations "${declarations}")
  string(REGEX MATCHALL "add_test\\([ \t\n]*NAME[ \t\n]+\"?[A-Za-z0-9_.-]+"
               calls "${declarations}")
  foreach(call IN LISTS calls)
    string(REGEX MATCH "[A-Za-z0-9_.-]+$" name "${call}")
    list(APPEND registered "${name}")
  endforeach()
  string(REGEX MATCHALL
               "(set\\(|list\\(APPEND[ \t\n]+)CF_UNIT_TESTS[ \t\n]+[^)]*\\)"
               groups "${declarations}")
  foreach(group IN LISTS groups)
    string(REGEX MATCHALL "test_[A-Za-z0-9_]+" names "${group}")
    foreach(name IN LISTS names)
      list(APPEND registered "unit.${name}")
    endforeach()
  endforeach()
endforeach()
# Only the "Held by" column contains test names. Locate it by its heading
# since the generated tables have different numbers of descriptive columns.
file(STRINGS "${page}" rows)
set(tests "")
set(column -1)
foreach(row IN LISTS rows)
  if(NOT row MATCHES "^\\|")
    set(column -1)
    continue()
  endif()
  string(REPLACE "|" ";" cells "${row}")
  list(LENGTH cells count)
  if(row MATCHES "\\|[ \t]*Held by[ \t]*\\|")
    set(column 0)
    foreach(cell IN LISTS cells)
      string(STRIP "${cell}" label)
      if(label STREQUAL "Held by")
        break()
      endif()
      math(EXPR column "${column} + 1")
    endforeach()
  elseif(column GREATER_EQUAL 0 AND column LESS count)
    list(GET cells ${column} held)
    string(REGEX MATCHALL "[A-Za-z0-9_-]+\\.[A-Za-z0-9_.-]+" names "${held}")
    list(APPEND tests ${names})
  endif()
endforeach()
list(REMOVE_DUPLICATES tests)
foreach(name IN LISTS tests)
  if(NOT name IN_LIST registered)
    message(
      FATAL_ERROR
        "docs/Limits.md names the test ${name}, which is not registered")
  endif()
endforeach()

string(REGEX MATCHALL "\\[[^][\n]*\\]\\([^() \t\n]+\\)" links "${have}")
foreach(link IN LISTS links)
  string(REGEX REPLACE "^.*\\]\\((.*)\\)$" "\\1" target "${link}")
  if(target MATCHES "^[A-Za-z][A-Za-z0-9+.-]*:" OR target MATCHES "^//")
    continue()
  endif()
  string(REGEX REPLACE "#.*" "" path "${target}")
  if(path STREQUAL "")
    set(input "${page}")
  else()
    set(input "${SRC}/docs/${path}")
  endif()
  if(NOT EXISTS "${input}" OR IS_DIRECTORY "${input}")
    message(FATAL_ERROR "docs/Limits.md links to missing file: ${target}")
  endif()
  if(target MATCHES "#(.+)$")
    set(anchor "${CMAKE_MATCH_1}")
    file(STRINGS "${input}" headings REGEX "^#+[ \t]")
    set(found FALSE)
    foreach(heading IN LISTS headings)
      string(REGEX REPLACE "^#+[ \t]+" "" title "${heading}")
      string(TOLOWER "${title}" slug)
      string(REGEX REPLACE "[^a-z0-9_ \t-]" "" slug "${slug}")
      string(STRIP "${slug}" slug)
      string(REGEX REPLACE "[ \t]+" "-" slug "${slug}")
      if(anchor STREQUAL slug)
        set(found TRUE)
        break()
      endif()
    endforeach()
    if(NOT found)
      message(FATAL_ERROR "docs/Limits.md links to missing heading: ${target}")
    endif()
  endif()
endforeach()
message("limits gate: clean")
